{
  "version": 1,
  "blocks": {
    "N": {"zh": "名词组", "en": "Noun group"},
    "V": {"zh": "动词", "en": "Verb"},
    "S": {"zh": "句子怎么组织", "en": "Sentence building"}
  },
  "points": [
    {"id": "N.gender", "block": "N", "zh": "名词的阴阳性", "fr": "le genre du nom", "en": "noun gender", "explain_zh": "每个名词都有阴性或阳性，冠词和形容词跟着变：le livre / la table。", "level": "A1", "focus": false},
    {"id": "N.number", "block": "N", "zh": "名词的单复数", "fr": "le pluriel du nom", "en": "plural nouns", "explain_zh": "复数一般加 -s（不发音），-eau 加 -x：un ami → des amis。", "level": "A1", "focus": false},
    {"id": "N.article.def", "block": "N", "zh": "定冠词", "fr": "l'article défini", "en": "le/la/les", "explain_zh": "le / la / l' / les 指特定的或泛指一类的东西：le café, j'aime les chats。", "level": "A1", "focus": false},
    {"id": "N.article.indef", "block": "N", "zh": "不定冠词", "fr": "l'article indéfini", "en": "un/une/des", "explain_zh": "un / une / des 表示“一个、一些”：j'ai un frère。", "level": "A1", "focus": false},
    {"id": "N.article.partitive", "block": "N", "zh": "部分冠词", "fr": "l'article partitif", "en": "du/de la", "explain_zh": "du / de la / de l' 表示数不清的“一些”：du pain, de l'eau。", "level": "A1", "focus": false},
    {"id": "N.article.de_negation", "block": "N", "zh": "否定后冠词变 de", "fr": "pas de", "en": "pas de", "explain_zh": "否定句里 un / une / du / des 变成 de：je n'ai pas de voiture。", "level": "A1", "focus": false},
    {"id": "N.article.contraction", "block": "N", "zh": "缩合冠词", "fr": "les articles contractés", "en": "au/du contraction", "explain_zh": "à + le = au，à + les = aux，de + le = du，de + les = des：au cinéma。", "level": "A1", "focus": false},
    {"id": "N.adj.agreement", "block": "N", "zh": "形容词性数配合", "fr": "l'accord de l'adjectif", "en": "adjective agreement", "explain_zh": "形容词跟名词变阴阳性和单复数：une petite maison, des amis contents。", "level": "A1", "focus": false},
    {"id": "N.adj.position", "block": "N", "zh": "形容词的位置", "fr": "la place de l'adjectif", "en": "adjective position", "explain_zh": "大多数形容词放在名词后面；beau, bon, grand, petit 等短词放前面。", "level": "A1", "focus": false},
    {"id": "N.possessive", "block": "N", "zh": "主有形容词", "fr": "les adjectifs possessifs", "en": "mon/ma/mes", "explain_zh": "mon / ma / mes 跟着“被拥有的东西”变：ma mère, mes amis。", "level": "A1", "focus": false},
    {"id": "N.demonstrative", "block": "N", "zh": "指示形容词", "fr": "les adjectifs démonstratifs", "en": "ce/cette/ces", "explain_zh": "ce / cet / cette / ces = 这个、那个：cet hôtel, cette semaine。", "level": "A1", "focus": false},
    {"id": "N.quantity", "block": "N", "zh": "数量表达", "fr": "les expressions de quantité", "en": "quantity + de", "explain_zh": "beaucoup de / un peu de / un kilo de 后面直接加名词，不加冠词：beaucoup de temps。", "level": "A1", "focus": false},
    {"id": "N.numbers", "block": "N", "zh": "数字、日期与序数", "fr": "les nombres", "en": "numbers and dates", "explain_zh": "数字和日期的读法：le 1er mai = le premier mai，2026 = deux mille vingt-six。", "level": "A1", "focus": false},
    {"id": "N.pronoun.subject", "block": "N", "zh": "主语代词", "fr": "les pronoms sujets", "en": "subject pronouns", "explain_zh": "je / tu / il / elle / on / nous / vous / ils / elles 做主语；on 常表示“我们、人们”。", "level": "A1", "focus": false},
    {"id": "N.pronoun.object_direct", "block": "N", "zh": "直接宾语代词", "fr": "les pronoms COD", "en": "direct object le/la", "explain_zh": "le / la / les / me / te 代替直接宾语：je la vois（我看见她）。", "level": "A2", "focus": false},
    {"id": "N.pronoun.object_indirect", "block": "N", "zh": "间接宾语代词", "fr": "les pronoms COI", "en": "indirect object lui/leur", "explain_zh": "lui / leur 代替 à + 人：je lui parle（我跟他说话）。", "level": "A2", "focus": false},
    {"id": "N.pronoun.reflexive", "block": "N", "zh": "自反代词", "fr": "les pronoms réfléchis", "en": "reflexive me/se", "explain_zh": "me / te / se / nous / vous 跟主语是同一个人：je me lave。", "level": "A1", "focus": false},
    {"id": "N.pronoun.stressed", "block": "N", "zh": "重读人称代词", "fr": "les pronoms toniques", "en": "moi/toi/lui", "explain_zh": "moi / toi / lui / elle 用在介词后或强调：chez moi, et toi ?", "level": "A1", "focus": false},
    {"id": "N.pronoun.y", "block": "N", "zh": "代词 y", "fr": "le pronom y", "en": "pronoun y", "explain_zh": "y 代替地点或 à + 东西 = “那里、这件事”：j'y vais。", "level": "A2", "focus": false},
    {"id": "N.pronoun.en", "block": "N", "zh": "代词 en", "fr": "le pronom en", "en": "pronoun en", "explain_zh": "en 代替 de + 东西或数量 = “一些、它”：j'en veux deux。", "level": "A2", "focus": false},
    {"id": "N.pronoun.demonstrative", "block": "N", "zh": "指示代词", "fr": "les pronoms démonstratifs", "en": "celui/ça", "explain_zh": "celui / celle / ceux / ça 代替前面提过的东西：celle-ci, ça va。", "level": "A2", "focus": false},
    {"id": "N.indefinite", "block": "N", "zh": "不定词", "fr": "les indéfinis", "en": "tout/chaque/quelqu'un", "explain_zh": "tout / chaque / quelques / quelqu'un / autre 表示不确定的人或数量：tous les jours。", "level": "A2", "focus": false},
    {"id": "N.comparison", "block": "N", "zh": "比较级与最高级", "fr": "le comparatif et le superlatif", "en": "plus/moins que", "explain_zh": "plus / moins / aussi … que 比较，le plus 表示“最”：plus grand que, le meilleur。", "level": "A2", "focus": false},

    {"id": "V.present.er", "block": "V", "zh": "现在时：-er 动词", "fr": "le présent des verbes en -er", "en": "présent -er", "explain_zh": "去 -er 加 -e, -es, -e, -ons, -ez, -ent；-e/-es/-ent 都不发音：je parle, ils parlent。", "level": "A1", "focus": true},
    {"id": "V.present.ir", "block": "V", "zh": "现在时：-ir 动词（finir 型）", "fr": "le présent des verbes en -ir", "en": "présent -ir (finir)", "explain_zh": "finir 型：je finis, nous finissons, ils finissent（复数多 -ss-）。", "level": "A1", "focus": true},
    {"id": "V.present.re", "block": "V", "zh": "现在时：-re 动词", "fr": "le présent des verbes en -re", "en": "présent -re", "explain_zh": "attendre 型：j'attends, il attend（il 没有词尾）, ils attendent。", "level": "A1", "focus": true},
    {"id": "V.present.etre", "block": "V", "zh": "现在时：être", "fr": "le présent d'être", "en": "être", "explain_zh": "être = 是：je suis, tu es, il est, nous sommes, vous êtes, ils sont。", "level": "A1", "focus": true},
    {"id": "V.present.avoir", "block": "V", "zh": "现在时：avoir", "fr": "le présent d'avoir", "en": "avoir", "explain_zh": "avoir = 有：j'ai, tu as, il a, nous avons, vous avez, ils ont；年龄也用 avoir：j'ai 30 ans。", "level": "A1", "focus": true},
    {"id": "V.present.aller", "block": "V", "zh": "现在时：aller", "fr": "le présent d'aller", "en": "aller", "explain_zh": "aller = 去：je vais, tu vas, il va, nous allons, vous allez, ils vont。", "level": "A1", "focus": true},
    {"id": "V.present.faire", "block": "V", "zh": "现在时：faire", "fr": "le présent de faire", "en": "faire", "explain_zh": "faire = 做：je fais, il fait, nous faisons, vous faites, ils font；il fait beau = 天气好。", "level": "A1", "focus": true},
    {"id": "V.present.pouvoir", "block": "V", "zh": "现在时：pouvoir", "fr": "le présent de pouvoir", "en": "pouvoir", "explain_zh": "pouvoir = 能、可以，后面接不定式：je peux, tu peux, il peut, ils peuvent。", "level": "A1", "focus": true},
    {"id": "V.present.vouloir", "block": "V", "zh": "现在时：vouloir", "fr": "le présent de vouloir", "en": "vouloir", "explain_zh": "vouloir = 想要：je veux, tu veux, il veut, nous voulons, ils veulent。", "level": "A1", "focus": true},
    {"id": "V.present.devoir", "block": "V", "zh": "现在时：devoir", "fr": "le présent de devoir", "en": "devoir", "explain_zh": "devoir = 必须、应该：je dois, il doit, nous devons, ils doivent。", "level": "A1", "focus": true},
    {"id": "V.present.irregular", "block": "V", "zh": "现在时：其他常用不规则动词", "fr": "le présent des verbes irréguliers", "en": "other irregular présent", "explain_zh": "venir, prendre, savoir, dire, voir, mettre 等要单独记：je viens, je prends, je sais。", "level": "A1", "focus": true},
    {"id": "V.pc.avoir", "block": "V", "zh": "复合过去时：avoir + 过去分词", "fr": "le passé composé avec avoir", "en": "passé composé avoir", "explain_zh": "大多数动词用 avoir + 过去分词讲过去做完的事：j'ai mangé。", "level": "A1", "focus": true},
    {"id": "V.pc.etre", "block": "V", "zh": "复合过去时：être + 过去分词", "fr": "le passé composé avec être", "en": "passé composé être", "explain_zh": "移动类动词（aller, venir, partir…）和代词式动词用 être：je suis allé, je me suis levé。", "level": "A1", "focus": true},
    {"id": "V.pc.participle", "block": "V", "zh": "过去分词的形式", "fr": "le participe passé", "en": "past participle", "explain_zh": "-er → -é，-ir → -i，不规则要记：fait, pris, vu, eu, été。", "level": "A1", "focus": true},
    {"id": "V.pc.agreement", "block": "V", "zh": "过去分词的配合", "fr": "l'accord du participe passé", "en": "participle agreement", "explain_zh": "用 être 时过去分词跟主语配合：elle est partie, ils sont venus。", "level": "A2", "focus": true},
    {"id": "V.imparfait", "block": "V", "zh": "未完成过去时", "fr": "l'imparfait", "en": "imparfait", "explain_zh": "描述过去的背景和习惯：quand j'étais petit, je jouais au foot。", "level": "A2", "focus": false},
    {"id": "V.futur_proche", "block": "V", "zh": "最近将来时", "fr": "le futur proche", "en": "aller + infinitive", "explain_zh": "aller + 不定式 = 马上要做：je vais partir。", "level": "A1", "focus": false},
    {"id": "V.futur_simple", "block": "V", "zh": "简单将来时", "fr": "le futur simple", "en": "futur simple", "explain_zh": "不定式 + -ai, -as, -a…：je parlerai demain；常用于计划和承诺。", "level": "A2", "focus": false},
    {"id": "V.passe_recent", "block": "V", "zh": "最近过去时", "fr": "le passé récent", "en": "venir de + infinitive", "explain_zh": "venir de + 不定式 = 刚刚做了：je viens de manger。", "level": "A2", "focus": false},
    {"id": "V.imperative", "block": "V", "zh": "命令式", "fr": "l'impératif", "en": "imperative", "explain_zh": "不带主语，直接用动词：Écoutez ! Viens ici. Choisissez la bonne réponse.", "level": "A1", "focus": false},
    {"id": "V.conditionnel.politesse", "block": "V", "zh": "礼貌条件式", "fr": "le conditionnel de politesse", "en": "je voudrais", "explain_zh": "用条件式让请求更客气：je voudrais un café, pourriez-vous m'aider ?", "level": "A1", "focus": false},
    {"id": "V.conditionnel.present", "block": "V", "zh": "条件式现在时", "fr": "le conditionnel présent", "en": "conditionnel", "explain_zh": "表示假设或愿望：si j'avais le temps, je voyagerais。", "level": "B1", "focus": false},
    {"id": "V.verb_infinitive", "block": "V", "zh": "动词 + 不定式", "fr": "verbe + infinitif", "en": "verb + infinitive", "explain_zh": "pouvoir / vouloir / devoir / aimer 后面直接接动词原形：je peux venir。", "level": "A1", "focus": false},
    {"id": "V.verb_prep_infinitive", "block": "V", "zh": "动词 + à / de + 不定式", "fr": "verbe + à/de + infinitif", "en": "verb + à/de + infinitive", "explain_zh": "有些动词要先加 à 或 de：commencer à lire, essayer de comprendre。", "level": "A2", "focus": false},
    {"id": "V.pronominal", "block": "V", "zh": "代词式动词", "fr": "les verbes pronominaux", "en": "pronominal verbs", "explain_zh": "动词前带 se：se lever, s'appeler → je m'appelle, il se lève。", "level": "A1", "focus": false},
    {"id": "V.impersonal", "block": "V", "zh": "无人称结构", "fr": "les tournures impersonnelles", "en": "il faut / il fait", "explain_zh": "il 不指人：il faut partir（必须走）, il pleut, il fait froid。", "level": "A1", "focus": false},
    {"id": "V.subjonctif", "block": "V", "zh": "虚拟式入门", "fr": "le subjonctif présent", "en": "subjonctif", "explain_zh": "il faut que / je veux que 后面用虚拟式：il faut que tu viennes。", "level": "B1", "focus": false},
    {"id": "V.passive", "block": "V", "zh": "被动态", "fr": "la voix passive", "en": "passive", "explain_zh": "être + 过去分词（+ par）= 被……：la lettre est écrite par Marie。", "level": "B1", "focus": false},

    {"id": "S.order.object_pronoun", "block": "S", "zh": "宾语代词放在动词前", "fr": "la place du pronom complément", "en": "pronoun before verb", "explain_zh": "代词宾语放在动词前（有不定式时放在不定式前）：je le vois, tu peux m'aider。", "level": "A2", "focus": false},
    {"id": "S.neg.ne_pas", "block": "S", "zh": "否定 ne … pas", "fr": "la négation ne … pas", "en": "ne … pas", "explain_zh": "ne 和 pas 夹住动词：je ne sais pas；口语里 ne 常省略。", "level": "A1", "focus": false},
    {"id": "S.neg.ne_jamais", "block": "S", "zh": "否定 ne … jamais", "fr": "ne … jamais", "en": "ne … jamais", "explain_zh": "ne … jamais = 从不：je ne bois jamais de café。", "level": "A1", "focus": false},
    {"id": "S.neg.ne_plus", "block": "S", "zh": "否定 ne … plus", "fr": "ne … plus", "en": "ne … plus", "explain_zh": "ne … plus = 不再：il n'habite plus ici。", "level": "A1", "focus": false},
    {"id": "S.neg.ne_rien", "block": "S", "zh": "否定 ne … rien / personne", "fr": "ne … rien, ne … personne", "en": "ne … rien/personne", "explain_zh": "ne … rien = 什么也不，ne … personne = 谁也不：je ne vois rien。", "level": "A2", "focus": false},
    {"id": "S.neg.aucun", "block": "S", "zh": "否定 ne … aucun", "fr": "ne … aucun(e)", "en": "ne … aucun", "explain_zh": "aucun(e) 本身就是“一个也没有”，和 ne 搭配，不加 pas：aucune dispense n'est autorisée。", "level": "A2", "focus": false},
    {"id": "S.neg.ne_que", "block": "S", "zh": "ne … que = 只", "fr": "la restriction ne … que", "en": "ne … que = only", "explain_zh": "ne … que 不是否定，意思是“只”：je n'ai que dix euros。", "level": "A2", "focus": false},
    {"id": "S.question.intonation", "block": "S", "zh": "语调疑问句", "fr": "la question par intonation", "en": "rising intonation", "explain_zh": "语序不变，句末升调就是问句：Tu viens ?", "level": "A1", "focus": false},
    {"id": "S.question.est_ce_que", "block": "S", "zh": "est-ce que 疑问句", "fr": "la question avec est-ce que", "en": "est-ce que", "explain_zh": "句首加 est-ce que，语序不变：Est-ce que tu viens ?", "level": "A1", "focus": false},
    {"id": "S.question.inversion", "block": "S", "zh": "主谓倒装疑问句", "fr": "la question par inversion", "en": "inversion", "explain_zh": "动词和主语代词对调，中间加 -：Viens-tu ? Pouvez-vous répéter ?", "level": "A2", "focus": false},
    {"id": "S.question.words", "block": "S", "zh": "疑问词", "fr": "les mots interrogatifs", "en": "où/quand/quel", "explain_zh": "où / quand / comment / pourquoi / combien / quel 引出特殊疑问句：Où habites-tu ?", "level": "A1", "focus": false},
    {"id": "S.prep.a_de", "block": "S", "zh": "介词 à 和 de", "fr": "les prépositions à et de", "en": "à / de", "explain_zh": "à = 到、在、给；de = 的、从：je parle à Paul, le livre de Marie。", "level": "A1", "focus": false},
    {"id": "S.prep.places", "block": "S", "zh": "城市和国家前的介词", "fr": "à, en, au + lieux", "en": "à Paris / en France", "explain_zh": "城市用 à，阴性国家用 en，阳性国家用 au，复数用 aux：à Montréal, en France, au Canada。", "level": "A1", "focus": false},
    {"id": "S.prep.transport", "block": "S", "zh": "交通方式的介词", "fr": "en / à + transport", "en": "en bus / à pied", "explain_zh": "坐进去的用 en，骑的或走路用 à：en bus, en voiture, à vélo, à pied。", "level": "A1", "focus": false},
    {"id": "S.prep.chez", "block": "S", "zh": "介词 chez", "fr": "la préposition chez", "en": "chez", "explain_zh": "chez + 人 = 在某人家 / 某人的店里：chez moi, chez le médecin。", "level": "A1", "focus": false},
    {"id": "S.prep.time", "block": "S", "zh": "时间介词", "fr": "depuis, pendant, il y a", "en": "depuis / pendant / il y a", "explain_zh": "depuis = 从……起一直，pendant = 在……期间，il y a + 时间 = ……以前。", "level": "A2", "focus": false},
    {"id": "S.relative.qui_que", "block": "S", "zh": "关系代词 qui / que", "fr": "les pronoms relatifs qui et que", "en": "qui / que", "explain_zh": "qui 后面接动词（做主语），que 后面接主语：l'homme qui parle, le livre que je lis。", "level": "A2", "focus": false},
    {"id": "S.relative.ou_dont", "block": "S", "zh": "关系代词 où / dont", "fr": "les pronoms relatifs où et dont", "en": "où / dont", "explain_zh": "où 指地点或时间，dont 代替 de + 东西：la ville où j'habite, le livre dont je parle。", "level": "B1", "focus": false},
    {"id": "S.conj.coord", "block": "S", "zh": "并列连词与连接词", "fr": "et, mais, ou, donc, alors", "en": "et / mais / donc", "explain_zh": "et / mais / ou / donc / alors / ensuite 把两个意思连起来：je suis fatigué, mais je viens。", "level": "A1", "focus": false},
    {"id": "S.conj.cause", "block": "S", "zh": "表示原因", "fr": "parce que, car, comme", "en": "parce que", "explain_zh": "parce que / car = 因为：je reste parce qu'il pleut。", "level": "A1", "focus": false},
    {"id": "S.conj.quand", "block": "S", "zh": "时间从句 quand", "fr": "quand, pendant que", "en": "quand clause", "explain_zh": "quand / pendant que 引出时间：quand il fait beau, je marche。", "level": "A2", "focus": false},
    {"id": "S.conj.si", "block": "S", "zh": "条件句 si", "fr": "si + présent", "en": "si + présent", "explain_zh": "si + 现在时，主句用现在时或将来时：si tu veux, on y va。", "level": "A2", "focus": false},
    {"id": "S.que_clause", "block": "S", "zh": "que 引导的宾语从句", "fr": "la complétive avec que", "en": "je pense que", "explain_zh": "je pense que / il dit que + 完整句子：je pense qu'il a raison。", "level": "A2", "focus": false},
    {"id": "S.il_y_a", "block": "S", "zh": "il y a = 有", "fr": "il y a", "en": "il y a", "explain_zh": "il y a + 名词 = 有、存在：il y a un problème；+ 时间 = ……以前。", "level": "A1", "focus": false},
    {"id": "S.cest", "block": "S", "zh": "c'est 与 il est", "fr": "c'est / il est", "en": "c'est / il est", "explain_zh": "c'est + 名词或评价，il est + 职业或形容词：c'est mon ami, il est médecin。", "level": "A1", "focus": false},
    {"id": "S.time.expressions", "block": "S", "zh": "时间表达", "fr": "les expressions de temps", "en": "time expressions", "explain_zh": "aujourd'hui / hier / demain / à 8 heures / le lundi 说明什么时候，多放句首或句末。", "level": "A1", "focus": false},
