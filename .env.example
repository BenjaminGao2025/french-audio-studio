# French Audio Studio Environment Configuration

# Output directory for generated MP3 audio and SRT/VTT subtitles
OUTPUT_DIR=./outputs

# OpenAI-compatible LLM endpoint (e.g., Perplexity web2api, Local LLM gateway, or OpenAI)
PERPLEXITY_BASE_URL=http://127.0.0.1:8002/v1

# Primary model for French transformation (options: grok-4.6, grok-4.6-thinking, sonar-2)
PERPLEXITY_MODEL=grok-4.6

# Fallback proofreading model
PERPLEXITY_PROOFREAD_MODEL=gpt-5.6-terra

# LLM request timeout in seconds
PERPLEXITY_TIMEOUT_SECONDS=120

# Maximum allowed characters for input text
MAX_TEXT_CHARS=15000
